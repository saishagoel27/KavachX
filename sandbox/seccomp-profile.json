{
  "_comment": [
    "Seccomp profile for the KavachX sandbox, applied on top of gVisor's own syscall filtering.",
    "",
    "Default action is SCMP_ACT_ERRNO: anything not listed returns EPERM rather than killing the",
    "process, so a target that probes for a blocked syscall reports a clean error we can observe",
    "instead of dying in a way that looks like a crash we found.",
    "",
    "Notably absent: every socket call (socket, connect, bind, listen, accept, sendto, recvfrom),",
    "every mount call, ptrace, and the kernel-module and reboot families. Networking is denied",
    "twice over — here and by --network none — because the egress figure in the certificate is a",
    "measurement and it needs to be true.",
    "",
    "Applied by app/sandbox/gvisor.py via --security-opt seccomp=<this file>."
  ],
  "defaultAction": "SCMP_ACT_ERRNO",
  "defaultErrnoRet": 1,
  "archMap": [
    {
      "architecture": "SCMP_ARCH_X86_64",
      "subArchitectures": ["SCMP_ARCH_X86", "SCMP_ARCH_X32"]
    },
    {
      "architecture": "SCMP_ARCH_AARCH64",
      "subArchitectures": ["SCMP_ARCH_ARM"]
    }
  ],
  "syscalls": [
    {
      "_comment": "Process and thread lifecycle. clone is needed for threads and subprocesses.",
      "names": [
        "clone",
        "clone3",
        "execve",
        "execveat",
        "exit",
        "exit_group",
        "fork",
        "vfork",
        "wait4",
        "waitid",
        "getpid",
        "getppid",
        "gettid",
        "set_tid_address",
        "sched_getaffinity",
        "sched_yield",
        "prctl",
        "arch_prctl",
        "futex",
        "futex_waitv",
        "set_robust_list",
        "get_robust_list",
        "rseq"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "Filesystem reads and writes within the workspace and the tmpfs.",
      "names": [
        "open",
        "openat",
        "openat2",
        "close",
        "close_range",
        "read",
        "pread64",
        "readv",
        "preadv",
        "write",
        "pwrite64",
        "writev",
        "pwritev",
        "lseek",
        "stat",
        "fstat",
        "lstat",
        "newfstatat",
        "statx",
        "access",
        "faccessat",
        "faccessat2",
        "getdents",
        "getdents64",
        "getcwd",
        "chdir",
        "fchdir",
        "readlink",
        "readlinkat",
        "unlink",
        "unlinkat",
        "rename",
        "renameat",
        "renameat2",
        "mkdir",
        "mkdirat",
        "rmdir",
        "ftruncate",
        "truncate",
        "fsync",
        "fdatasync",
        "fcntl",
        "flock",
        "dup",
        "dup2",
        "dup3",
        "pipe",
        "pipe2",
        "umask",
        "utimensat",
        "fchmod",
        "fchmodat"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "Memory management.",
      "names": [
        "mmap",
        "mremap",
        "munmap",
        "mprotect",
        "brk",
        "madvise",
        "mlock",
        "munlock",
        "membarrier"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "Signals, timers and clocks.",
      "names": [
        "rt_sigaction",
        "rt_sigprocmask",
        "rt_sigreturn",
        "rt_sigtimedwait",
        "rt_sigsuspend",
        "sigaltstack",
        "kill",
        "tkill",
        "tgkill",
        "nanosleep",
        "clock_nanosleep",
        "clock_gettime",
        "clock_getres",
        "gettimeofday",
        "times",
        "timer_create",
        "timer_settime",
        "timer_delete",
        "getrusage",
        "getrlimit",
        "prlimit64",
        "setrlimit"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "Polling and event loops (asyncio, subprocess pipes).",
      "names": [
        "poll",
        "ppoll",
        "select",
        "pselect6",
        "epoll_create",
        "epoll_create1",
        "epoll_ctl",
        "epoll_wait",
        "epoll_pwait",
        "eventfd",
        "eventfd2",
        "ioctl",
        "sysinfo",
        "uname",
        "getrandom",
        "getuid",
        "geteuid",
        "getgid",
        "getegid",
        "getgroups"
      ],
      "action": "SCMP_ACT_ALLOW"
    }
  ]
}
