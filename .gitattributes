# Consistent line endings across Windows and Linux/WSL.
# Let git detect text vs binary by default.
* text=auto

# Unix shell scripts MUST be LF — CRLF breaks bash/WSL ("bad interpreter", stray \r).
*.sh text eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
