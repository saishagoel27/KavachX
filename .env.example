# ---------------------------------------------------------------------------
# KavachX environment
# Copy to .env and adjust. Never commit a real .env.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
KAVACHX_ENV=development
DEV_MODE=true

# --- Logging (logifyx) -----------------------------------------------------
LOG_LEVEL=INFO
# console -> logifyx's colour-coded human format (level-coloured line, blue location)
# json    -> one JSON object per line, for aggregators
#
# These are one switch, not two. logifyx builds its console handler with
# get_formatter(json_mode, color) and its file handler with color=False, so json_mode=True
# selects the JSON formatter for both sinks and ignores `color` entirely — there is no
# "JSON file plus coloured console" combination available.
#
# Comment this out to let it follow DEV_MODE: console when developing, json otherwise.
LOG_FORMAT=console
# logifyx's own knobs are honoured too; KavachX sets log_dir/file/rotation in code.
LOG_MASK=True
LOG_DIR=logs

# --- Database --------------------------------------------------------------
# Docker Compose path (backend container -> postgres service)
# DATABASE_URL=postgresql+asyncpg://kavachx:kavachx@postgres:5432/kavachx
# Native Windows / local path (docker compose exposes 5433 on the host)
DATABASE_URL=postgresql+asyncpg://kavachx:kavachx@localhost:5433/kavachx
DB_ECHO=false
DB_POOL_SIZE=10
# Startup provisioning: migrate to head and seed the demo tenant when the API boots, so a fresh
# database cannot produce "relation \"users\" does not exist". Both steps are no-ops once done.
DB_AUTO_PROVISION=true
DB_STARTUP_WAIT_SECONDS=15

# --- Auth ------------------------------------------------------------------
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=1209600
PASSWORD_MIN_LENGTH=12

# --- Certificate signing ---------------------------------------------------
# HMAC key used to sign PRAMAAN certificates. Rotate per deployment.
CERTIFICATE_SIGNING_KEY=change-me-certificate-signing-key

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- LLM provider ----------------------------------------------------------
# groq  : hosted Groq inference (default)
# llama : llama.cpp / any OpenAI-compatible server — the local, air-gapped path
# mock  : deterministic scripted proposer (offline; what the test suite uses)
LLM_PROVIDER=groq

# Groq. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
GROQ_MODEL_WORKHORSE=openai/gpt-oss-120b
GROQ_MODEL_ROUTER=llama-3.1-8b-instant
GROQ_MODEL_SECURITY=openai/gpt-oss-120b

# Local llama.cpp server (air-gapped path). Model portfolio from the specification.
LLAMA_BASE_URL=http://localhost:8080/v1
LLAMA_API_KEY=
LLAMA_MODEL_WORKHORSE=Qwen3-Coder-30B-A3B
LLAMA_MODEL_ROUTER=Qwen3-4B
LLAMA_MODEL_SECURITY=Foundation-Sec-8B-Reasoning

LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0.1
# Hard ceiling per run. The orchestrator aborts rather than exceeding it.
LLM_RUN_TOKEN_BUDGET=400000
# If the configured provider is unreachable or unkeyed, fall back to the deterministic
# mock proposer so a demo run still completes (clearly labelled in the run trace).
LLM_FALLBACK_TO_MOCK=true

# --- Sandbox ---------------------------------------------------------------
# dev         : local subprocess adapter. NOT an isolation boundary. Dev only.
# gvisor      : docker run --runtime=runsc
# firecracker : microVM adapter (Linux + KVM)
SANDBOX_ADAPTER=dev
SANDBOX_IMAGE=kavachx/sandbox:dev
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_MB=2048
SANDBOX_PID_LIMIT=256
SANDBOX_DISK_MB=1024
SANDBOX_WALL_CLOCK_SECONDS=120
SANDBOX_WORKSPACE_ROOT=

# --- Orchestrator limits ---------------------------------------------------
MAX_HARNESS_ITERATIONS=3
MAX_PATCH_ITERATIONS=3
MAX_CLAUSE_ITERATIONS=2
RUN_MAX_RUNTIME_SECONDS=1800

# --- GitNexus (code knowledge graph) ---------------------------------------
# The code knowledge graph provider, installed repo-locally into ./gitnexus/node_modules
# by `make gitnexus`. Licence: PolyForm Noncommercial 1.0.0 — GitNexus only, not KavachX.
# See docs/CODE_GRAPH.md.
#
# Optional by design: when it is absent KavachX indexes with tree-sitter alone, every
# relationship is a name match rather than a resolved reference, and the index health report
# caps the grade and records that bound.
GITNEXUS_ENABLED=true
# Explicit path to the binary. Highest authority in the resolution chain:
#   GITNEXUS_BIN -> PATH -> <repo>/gitnexus/node_modules/.bin -> npx (opt-in)
# Leave blank to use the repo-local install. `make gitnexus-doctor` reports what resolved.
GITNEXUS_BIN=
# Version used when resolving through npx, and recorded in the index identity. Keep this in
# step with the dependency pinned in gitnexus/package.json.
GITNEXUS_VERSION=1.6.9
# Allow falling back to `npx -y gitnexus@<version>` when no binary is found. This reaches the
# network on first use per machine; it is not exercised while the repo-local install resolves.
GITNEXUS_ALLOW_NPX=true
# LadybugDB optional-extension policy: auto | load-only | never.
# "load-only" keeps indexing offline — KavachX uses the graph, not full-text or vector search.
GITNEXUS_EXTENSION_INSTALL=load-only
# true skips grammars needing native compilation (Dart/Swift/Kotlin/Proto) and simply leaves
# those languages unindexed. false builds them, which needs a working native toolchain at
# `make gitnexus` time.
GITNEXUS_SKIP_OPTIONAL_GRAMMARS=false
# Build the CFG/PDG substrate. Enables statement-level dependence queries at real time cost,
# so a large repository may need GITNEXUS_ANALYZE_TIMEOUT_SECONDS raised.
GITNEXUS_PDG=true
GITNEXUS_MAX_FILE_SIZE_KB=512
# Parse worker pool size. 0 leaves GitNexus's own default (cores-1, capped at 16).
GITNEXUS_WORKERS=0
GITNEXUS_PROBE_TIMEOUT_SECONDS=60
GITNEXUS_ANALYZE_TIMEOUT_SECONDS=900
GITNEXUS_QUERY_TIMEOUT_SECONDS=120
# Row cap per Cypher query. Bounds memory on a large repository.
GITNEXUS_MAX_ROWS=200000

# --- GitHub (fine-grained personal access token) ---------------------------
# KavachX authenticates with a fine-grained PAT — there is no GitHub App path yet; see
# docs/PR_BOT.md for the decisions that would change that.
# Create one at https://github.com/settings/personal-access-tokens with, on the target
# repositories, Repository permissions: Contents: read/write and Pull requests: read/write.
# The token is never written to the database. Leave blank for the local/dry-run demo.
#
# With a token set, the console offers "Attach a repository you can push to": push access is
# confirmed against the API before attaching, the source is cloned at ingest, and a verified
# repair can become a real pull request. Without one, only public (analysis-only) repositories
# and the seeded local target are available.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
# Clone origin for token-verified repositories. Separate from the API base because GitHub
# Enterprise serves git and the REST API from different hosts.
GITHUB_CLONE_BASE=https://github.com
# When true the publisher writes a dry-run artifact instead of calling GitHub.
PUBLISHER_DRY_RUN=true

# --- Demo seed -------------------------------------------------------------
SEED_DEMO=true
DEMO_USER_EMAIL=demo@kavachx.io
DEMO_USER_PASSWORD=kavachx-demo-2024
DEMO_ORG_NAME=Kavach Research
# Absolute path to the seeded local target. Leave blank to auto-detect
# <repo-root>/examples/vulnerable-demo.
DEMO_REPO_PATH=

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=KavachX