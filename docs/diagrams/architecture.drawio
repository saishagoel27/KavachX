        <mxCell id="lane0" value="1 - CODE INTELLIGENCE - deterministic, no model" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#151719;strokeColor=#3a494b;dashed=1;verticalAlign=top;align=center;fontColor=#00dbe7;fontSize=13;fontStyle=1;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="34" y="76" width="302" height="692" as="geometry"/></mxCell>
        <mxCell id="lane1" value="2 - SECURITY MODEL - taxonomy-driven" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#151719;strokeColor=#3a494b;dashed=1;verticalAlign=top;align=center;fontColor=#00dbe7;fontSize=13;fontStyle=1;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="414" y="76" width="302" height="576" as="geometry"/></mxCell>
        <mxCell id="lane2" value="3 - REASONING - the ONLY model call" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#151719;strokeColor=#3a494b;dashed=1;verticalAlign=top;align=center;fontColor=#00dbe7;fontSize=13;fontStyle=1;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="794" y="76" width="302" height="454" as="geometry"/></mxCell>
        <mxCell id="lane3" value="4 - PROOF BY EXECUTION - the sandbox decides" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#151719;strokeColor=#3a494b;dashed=1;verticalAlign=top;align=center;fontColor=#00dbe7;fontSize=13;fontStyle=1;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1174" y="76" width="302" height="546" as="geometry"/></mxCell>
        <mxCell id="lane4" value="5 - REPAIR AND ADVERSARIAL VERIFICATION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#151719;strokeColor=#3a494b;dashed=1;verticalAlign=top;align=center;fontColor=#00dbe7;fontSize=13;fontStyle=1;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1554" y="76" width="302" height="586" as="geometry"/></mxCell>
        <mxCell id="lane5" value="6 - PROOF-CARRYING OUTPUT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#151719;strokeColor=#3a494b;dashed=1;verticalAlign=top;align=center;fontColor=#00dbe7;fontSize=13;fontStyle=1;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1934" y="76" width="302" height="392" as="geometry"/></mxCell>
        <mxCell id="repo" value="&lt;b&gt;Target repository&lt;/b&gt;&lt;br/&gt;pinned to an immutable content SHA-256&lt;br/&gt;&lt;i&gt;untrusted DATA, never instructions&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;fontSize=11;fillColor=#0d2b2f;strokeColor=#00c8d4;fontColor=#e6f6f7;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="250" height="78" as="geometry"/></mxCell>
        <mxCell id="gn" value="&lt;b&gt;GitNexus&lt;/b&gt; provider (optional)&lt;br/&gt;resolved symbol references&lt;br/&gt;&lt;i&gt;precise, incomplete&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;fontSize=11;fillColor=#0d2b2f;strokeColor=#00c8d4;fontColor=#e6f6f7;" vertex="1" parent="1"><mxGeometry x="60" y="232" width="250" height="68" as="geometry"/></mxCell>
        <mxCell id="ts" value="&lt;b&gt;tree-sitter&lt;/b&gt; provider (always on)&lt;br/&gt;name-matched refs, 3 grammars&lt;br/&gt;&lt;i&gt;complete, imprecise&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;fontSize=11;fillColor=#0d2b2f;strokeColor=#00c8d4;fontColor=#e6f6f7;" vertex="1" parent="1"><mxGeometry x="60" y="334" width="250" height="68" as="geometry"/></mxCell>
        <mxCell id="merge" value="&lt;b&gt;Provider merge&lt;/b&gt;&lt;br/&gt;per-EDGE provenance + precision&lt;br/&gt;resolved vs union" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;fontSize=11;fillColor=#0d2b2f;strokeColor=#00c8d4;fontColor=#e6f6f7;" vertex="1" parent="1"><mxGeometry x="60" y="436" width="250" height="68" as="geometry"/></mxCell>
        <mxCell id="kg" value="&lt;b&gt;Code knowledge graph&lt;/b&gt;&lt;br/&gt;reproducible identity =&lt;br/&gt;sha256(source + parser versions + options)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;fontSize=11;fillColor=#0d2b2f;strokeColor=#00c8d4;fontColor=#e6f6f7;" vertex="1" parent="1"><mxGeometry x="60" y="538" width="250" height="78" as="geometry"/></mxCell>
        <mxCell id="health" value="&lt;b&gt;Index validation&lt;/b&gt;&lt;br/&gt;10 checks, grade A/B/C/F&lt;br/&gt;&lt;b&gt;+ CLAIM BOUNDS&lt;/b&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fontSize=11;fillColor=#3a2c08;strokeColor=#f5b642;fontColor=#fdf3dd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="250" height="92" as="geometry"/></mxCell>
        <mxCell id="tax" value="&lt;b&gt;60 taxonomy rules&lt;/b&gt;, extensible&lt;br/&gt;19 sources, 23 sinks, 9 sanitizers&lt;br/&gt;5 validators, 4 auth controls" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;fontSize=11;fillColor=#0d2b2f;strokeColor=#00c8d4;fontColor=#e6f6f7;" vertex="1" parent="1"><mxGeometry x="440" y="120" width="250" height="78" as="geometry"/></mxCell>
        <mxCell id="taint" value="&lt;b&gt;Taint analysis&lt;/b&gt; over the AST&lt;br/&gt;proves derivation inside a function" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;fontSize=11;fillColor=#0d2b2f;strokeColor=#00c8d4;fontColor=#e6f6f7;" vertex="1" parent="1"><mxGeometry x="440" y="232" width="250" height="58" as="geometry"/></mxCell>
        <mxCell id="flow" value="&lt;b&gt;Security flows&lt;/b&gt;&lt;br/&gt;every flow states its &lt;b&gt;basis&lt;/b&gt;&lt;br/&gt;taint / call-graph / proximity&lt;br/&gt;+ precision + reachability" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;fontSize=11;fillColor=#0d2b2f;strokeColor=#00c8d4;fontColor=#e6f6f7;" vertex="1" parent="1"><mxGeometry x="440" y="324" width="250" height="88" as="geometry"/></mxCell>
        <mxCell id="bound" value="&lt;b&gt;Trust boundaries&lt;/b&gt;&lt;br/&gt;11 kinds, from (source, sink)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;fontSize=11;fillColor=#0d2b2f;strokeColor=#00c8d4;fontColor=#e6f6f7;" vertex="1" parent="1"><mxGeometry x="440" y="446" width="250" height="58" as="geometry"/></mxCell>
        <mxCell id="surf" value="&lt;b&gt;Attack surface&lt;/b&gt;&lt;br/&gt;priority = &lt;b&gt;product&lt;/b&gt; of 6 factors&lt;br/&gt;severity, controllability, reachability,&lt;br/&gt;dataflow, controls, coverage" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;fontSize=11;fillColor=#0d2b2f;strokeColor=#00c8d4;fontColor=#e6f6f7;" vertex="1" parent="1"><mxGeometry x="440" y="538" width="250" height="88" as="geometry"/></mxCell>
        <mxCell id="ctx" value="&lt;b&gt;Context builder&lt;/b&gt;&lt;br/&gt;24 read-only graph tools&lt;br/&gt;hard character budget&lt;br/&gt;trust-labelled envelope:&lt;br/&gt;UNTRUSTED_repository_code&lt;br/&gt;every drop reported" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;fontSize=11;fillColor=#0d2b2f;strokeColor=#00c8d4;fontColor=#e6f6f7;" vertex="1" parent="1"><mxGeometry x="820" y="120" width="250" height="108" as="geometry"/></mxCell>
        <mxCell id="llm" value="&lt;b&gt;Local LLM - proposes only&lt;/b&gt;&lt;br/&gt;Qwen3-Coder-30B-A3B (&lt;b&gt;3B active&lt;/b&gt;)&lt;br/&gt;+ Qwen3-4B router&lt;br/&gt;llama.cpp / Ollama / vLLM&lt;br/&gt;&lt;i&gt;air-gapped: no token leaves&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;fontSize=11;fillColor=#241a38;strokeColor=#a78bfa;fontColor=#ece7fb;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820" y="262" width="250" height="108" as="geometry"/></mxCell>
        <mxCell id="schema" value="&lt;b&gt;Strict schema gate&lt;/b&gt;&lt;br/&gt;&lt;b&gt;NO field can assert a verdict&lt;/b&gt;&lt;br/&gt;reject → fallback still runs" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fontSize=11;fillColor=#3a2c08;strokeColor=#f5b642;fontColor=#fdf3dd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820" y="404" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="harn" value="&lt;b&gt;Harness generator&lt;/b&gt;&lt;br/&gt;KavachX templates only&lt;br/&gt;model strings become&lt;br/&gt;&lt;b&gt;DATA LITERALS&lt;/b&gt;, never code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;fontSize=11;fillColor=#0d2b2f;strokeColor=#00c8d4;fontColor=#e6f6f7;" vertex="1" parent="1"><mxGeometry x="1200" y="120" width="250" height="88" as="geometry"/></mxCell>
        <mxCell id="sbx" value="&lt;b&gt;SANDBOX&lt;/b&gt; - hostile code runs here&lt;br/&gt;no credentials, no network, non-root&lt;br/&gt;dropped caps, read-only root, capped&lt;br/&gt;dev | gVisor | Firecracker" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;fontSize=11;fillColor=#37150f;strokeColor=#ff6b5e;fontColor=#ffe8e5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1200" y="242" width="250" height="98" as="geometry"/></mxCell>
        <mxCell id="fuzz" value="&lt;b&gt;Coverage-guided fuzzing&lt;/b&gt;&lt;br/&gt;13 engines, 6 with feedback&lt;br/&gt;code-aware branch seeding&lt;br/&gt;useful = &lt;b&gt;measured&lt;/b&gt; coverage delta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;fontSize=11;fillColor=#0d2b2f;strokeColor=#00c8d4;fontColor=#e6f6f7;" vertex="1" parent="1"><mxGeometry x="1200" y="374" width="250" height="88" as="geometry"/></mxCell>
        <mxCell id="oracle" value="&lt;b&gt;13 deterministic oracles&lt;/b&gt;&lt;br/&gt;&lt;b&gt;UNSUPPORTED is not HELD&lt;/b&gt;&lt;br/&gt;N independent reproductions" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fontSize=11;fillColor=#3a2c08;strokeColor=#f5b642;fontColor=#fdf3dd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1200" y="496" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="shield" value="&lt;b&gt;Shield&lt;/b&gt; - reversible mitigation&lt;br/&gt;verified blocking AND benign-safe&lt;br/&gt;starts TIME TO PROTECTION" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;fontSize=11;fillColor=#0d2b2f;strokeColor=#00c8d4;fontColor=#e6f6f7;" vertex="1" parent="1"><mxGeometry x="1580" y="120" width="250" height="78" as="geometry"/></mxCell>
        <mxCell id="reg" value="&lt;b&gt;Regression test&lt;/b&gt; from the ACTUAL&lt;br/&gt;reproducing input, proven to fire&lt;br/&gt;on the &lt;b&gt;unpatched&lt;/b&gt; build first" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;fontSize=11;fillColor=#0d2b2f;strokeColor=#00c8d4;fontColor=#e6f6f7;" vertex="1" parent="1"><mxGeometry x="1580" y="232" width="250" height="78" as="geometry"/></mxCell>
        <mxCell id="root" value="Root cause verified on the&lt;br/&gt;executed path, blast radius" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;fontSize=11;fillColor=#0d2b2f;strokeColor=#00c8d4;fontColor=#e6f6f7;" vertex="1" parent="1"><mxGeometry x="1580" y="344" width="250" height="58" as="geometry"/></mxCell>
        <mxCell id="patch" value="Patch, AST policy gate&lt;br/&gt;applied to a &lt;b&gt;COPY&lt;/b&gt; in the sandbox" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;fontSize=11;fillColor=#0d2b2f;strokeColor=#00c8d4;fontColor=#e6f6f7;" vertex="1" parent="1"><mxGeometry x="1580" y="436" width="250" height="58" as="geometry"/></mxCell>
        <mxCell id="gaunt" value="&lt;b&gt;REFUTATION GAUNTLET&lt;/b&gt;&lt;br/&gt;it attacks its own patch&lt;br/&gt;mutation, siblings, replay, re-check" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fontSize=11;fillColor=#3a2c08;strokeColor=#f5b642;fontColor=#fdf3dd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1580" y="528" width="250" height="108" as="geometry"/></mxCell>
