# Copy to backend/.env and fill in. Nothing here is read at import time except
# through kavachx/core/config.py, so every value has a working dev default.

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=info

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call this API.
# Must include the exact scheme + host + port the frontend is served from.
# 5173 = vite dev, 4173 = vite preview. Add your deployed origin here later.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# ── Auth ──────────────────────────────────────────────────────────────────────
# false = dashboard endpoints accept a `role` parameter (local dev only).
# true  = every request must carry `Authorization: Bearer <session jwt>`.
AUTH_REQUIRED=false
DEMO_TENANT_ID=demo-tenant

# GitHub App credentials (from https://github.com/settings/apps)
GITHUB_APP_ID=<your_app_id>
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_APP_WEBHOOK_SECRET=<your_webhook_secret>

# JWT session tokens
JWT_SECRET=<random_32_byte_hex>
JWT_EXPIRY_SECONDS=3600

# Certificate signing (HMAC-SHA256)
CERT_SIGNING_SECRET=<random_32_byte_hex>

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://kavachx:kavachx@localhost:5432/kavachx

# ── Sandbox ───────────────────────────────────────────────────────────────────
# "gvisor" for local dev, "firecracker" for finale
SANDBOX_RUNTIME=gvisor
SANDBOX_SCRATCH_DIR=/tmp/kavachx-sandbox

# ── LLM ───────────────────────────────────────────────────────────────────────
# Path to llama.cpp server binary
LLAMA_CPP_BIN=/usr/local/bin/llama-server

# Model paths (downloaded separately)
MODEL_WORKHORSE_PATH=/models/qwen3-coder-30b-a3b-q4.gguf
MODEL_ROUTER_PATH=/models/qwen3-4b-q4.gguf

# llama.cpp server ports
LLAMA_WORKHORSE_PORT=8081
LLAMA_ROUTER_PORT=8082

# ── Artifact storage ──────────────────────────────────────────────────────────
ARTIFACT_STORE_PATH=/var/kavachx/artifacts

# ── Run engine ────────────────────────────────────────────────────────────────
# Per-tenant concurrent run cap (POST /api/runs returns 429 past this).
MAX_CONCURRENT_RUNS=2
# Seconds between pipeline phases — paces the SSE trace for the UI.
RUN_TICK_SECONDS=0.8
# Seconds between SSE keepalive comments.
SSE_KEEPALIVE_SECONDS=15
