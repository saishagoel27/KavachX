# KavachX frontend (Windows) → remote backend on the server.
# next dev reads THIS file (frontend/.env.local), not the repo-root .env.
#
# 1) Replace <SERVER-IP> with your server's public IP (the one you SSH to).
# 2) Then run:  npm install  &&  npm run dev   → http://localhost:3000
#
# This drives both the REST API and the live SSE run stream.
NEXT_PUBLIC_API_BASE_URL = "YOUR_NEXT_PUBLIC_API_BASE_URL"
NEXT_PUBLIC_APP_NAME = "YOUR_NEXT_PUBLIC_APP_NAME"