# Copy to frontend/.env. Only VITE_* keys reach the browser bundle —
# never put a secret in this file.

# Backend API root.
#  - absolute URL  → direct cross-origin calls; the origin this app runs on
#                    must appear in the backend's CORS_ALLOW_ORIGINS.
#  - empty string  → same-origin '/api' paths proxied by the vite dev server
#                    (VITE_DEV_PROXY_TARGET below), so CORS never applies.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Where the dev-server proxy forwards /api, /auth and /health.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Dev server ports.
VITE_PORT=5173
VITE_PREVIEW_PORT=4173

# Optional: session JWT, required once the backend runs with AUTH_REQUIRED=true.
# Leave blank in local development.
VITE_API_TOKEN=
